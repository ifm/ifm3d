# Generated by CMake – do not edit manually.
#
# On Windows (build-from-source, not NSIS), unregister PowerShell tab
# completion before files are removed so the script is still on disk.

if(WIN32 AND NOT "@CREATE_WIN_INSTALLER@")
  set(_unregister_script
    "@CMAKE_INSTALL_PREFIX@/share/ifm3d/completions/unregister_pwsh_completion.ps1")
  if(EXISTS "${_unregister_script}")
    find_program(_pwsh pwsh
      PATHS "$ENV{PROGRAMFILES}/PowerShell/7"
      NO_DEFAULT_PATH)
    if(NOT _pwsh)
      find_program(_pwsh powershell
        PATHS "$ENV{WINDIR}/System32/WindowsPowerShell/v1.0"
        NO_DEFAULT_PATH)
    endif()
    if(_pwsh)
      execute_process(
        COMMAND "${_pwsh}" -NoLogo -NoProfile -NonInteractive
                -ExecutionPolicy Bypass -File "${_unregister_script}"
        RESULT_VARIABLE _result
      )
      if(NOT _result EQUAL 0)
        message(WARNING
          "ifm3d: PowerShell tab completion removal failed (exit ${_result}).")
      endif()
    else()
      message(WARNING "ifm3d: powershell/pwsh not found; tab completion block "
        "was NOT removed from your profile. Run unregister_pwsh_completion.ps1 manually.")
    endif()
  endif()
endif()

if(NOT EXISTS "@CMAKE_BINARY_DIR@/install_manifest.txt")
  message(FATAL_ERROR
    "Cannot find install manifest: @CMAKE_BINARY_DIR@/install_manifest.txt")
endif()

file(READ "@CMAKE_BINARY_DIR@/install_manifest.txt" _files)
string(REGEX REPLACE "\n" ";" _files "${_files}")
foreach(_file ${_files})
  message(STATUS "Uninstalling $ENV{DESTDIR}${_file}")
  if(IS_SYMLINK "$ENV{DESTDIR}${_file}" OR EXISTS "$ENV{DESTDIR}${_file}")
    execute_process(
      COMMAND "@CMAKE_COMMAND@" -E remove "$ENV{DESTDIR}${_file}"
      RESULT_VARIABLE _result
    )
    if(NOT "${_result}" STREQUAL 0)
      message(STATUS "Problem removing $ENV{DESTDIR}${_file}")
    endif()
  else()
    message(STATUS "File $ENV{DESTDIR}${_file} does not exist.")
  endif()
endforeach()
